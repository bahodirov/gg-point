# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/ggpoint

# Option 2: Use individual settings (for development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ggpoint
# DB_USER=postgres
# DB_PASSWORD=your_password

# Database SSL Configuration
# CRITICAL: In production, SSL certificate verification is ALWAYS enabled for security.
# If NODE_ENV is undefined or empty, the application treats it as production (fail-safe).
# Setting DB_SSL_REJECT_UNAUTHORIZED=false in production will cause the application to fail startup.
# Only use DB_SSL_REJECT_UNAUTHORIZED=false in NODE_ENV=development with self-signed certificates.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Session Configuration
SESSION_SECRET=your-super-secret-key-change-in-production-min-32-chars

# Admin Bootstrap Credentials
# If ADMIN_PASSWORD is not set, a random password is generated on first setup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Upload Configuration
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=5242880
MAX_IMAGE_WIDTH=1920
THUMBNAIL_WIDTH=300

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20

# Application Configuration
NODE_ENV=development
PORT=4000

# CORS Configuration (production)
# CORS_ORIGIN=https://yourdomain.com

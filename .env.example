# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/ggpoint

# Option 2: Use individual settings (for development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ggpoint
# DB_USER=postgres
# DB_PASSWORD=your_password

# Database SSL Configuration
# Set to 'false' only if using self-signed certificates (not recommended for production)
# DB_SSL_REJECT_UNAUTHORIZED=false

# Session Configuration
SESSION_SECRET=your-super-secret-key-change-in-production-min-32-chars

# Upload Configuration
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=5242880
MAX_IMAGE_WIDTH=1920
THUMBNAIL_WIDTH=300

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20

# Application Configuration
NODE_ENV=development
PORT=4000

# Domain Configuration
DOMAIN=http://localhost:4200
API_URL=http://localhost:4000

# Contact Information
CONTACT_PHONE=+998-XX-XXX-XXXX
CONTACT_EMAIL=info@gg-point.uz
CONTACT_ADDRESS=Tashkent, Uzbekistan, Amir Temur Avenue
CONTACT_HOURS=Monday - Sunday, 9:00 - 20:00

# CORS Configuration (production)
# CORS_ORIGIN=https://yourdomain.com
